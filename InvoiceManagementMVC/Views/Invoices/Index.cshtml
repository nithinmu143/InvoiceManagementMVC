@model IEnumerable<InvoiceManagementMVC.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<h1>Invoice Management</h1>

<hr />

<!-- Dashboard Cards -->

<div class="row mb-4">

    <div class="col-md-4 mb-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Invoices</h5>
                <h2>@ViewBag.TotalInvoices</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Total Items</h5>
                <h2>@ViewBag.TotalItems</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-bg-dark">
            <div class="card-body">
                <h5 class="card-title">Total Invoice Value</h5>
                <h2>
                    €@(((decimal)ViewBag.TotalValue).ToString("N2"))
                </h2>
            </div>
        </div>
    </div>

</div>


<!-- Search -->

<div class="card mb-4">

    <div class="card-body">

        <form asp-action="Index"
              method="get"
              class="row g-2">

            <div class="col-md-8">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by invoice number or item name..." />

            </div>

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary w-100">
                    Search
                </button>

            </div>

            <div class="col-md-2">

                <a asp-action="Index"
                   class="btn btn-secondary w-100">
                    Clear
                </a>

            </div>

        </form>

    </div>

</div>


<!-- Create Invoice -->

<div class="mb-3">

    <a asp-action="Create"
       class="btn btn-success">
        + Create New Invoice
    </a>

</div>


<!-- Invoice Table -->

<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>
                <th>Invoice #</th>
                <th>Date of Issue</th>
                <th>Items</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var invoice in Model)
            {
                <tr>

                    <td>
                        <strong>
                            #@invoice.InvoiceNumber
                        </strong>
                    </td>

                    <td>
                        @invoice.DateOfIssue.ToString("dd-MM-yyyy HH:mm")
                    </td>

                    <td>
                        @invoice.InvoiceItems.Count
                    </td>

                    <td>
                        <strong>
                            €@((invoice.Total() ?? 0).ToString("N2"))
                        </strong>
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@invoice.InvoiceNumber"
                           class="btn btn-sm btn-primary">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@invoice.InvoiceNumber"
                           class="btn btn-sm btn-warning ms-1">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@invoice.InvoiceNumber"
                           class="btn btn-sm btn-danger ms-1">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>