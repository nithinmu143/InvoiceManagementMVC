@model InvoiceManagementMVC.Models.InvoiceItem

@{
    ViewData["Title"] = "Edit Invoice Item";
}

<h1>Edit Invoice Item</h1>

<hr />

<div class="row">

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">

                        <label class="form-label">
                            Item Title
                        </label>

                        <input name="title"
                               value="@Model.Title"
                               class="form-control"
                               maxlength="255"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("Title")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Quantity
                        </label>

                        <input name="quantity"
                               value="@Model.Quantity"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("Quantity")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Price
                        </label>

                        <input name="price"
                               value="@Model.Price"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("Price")
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-controller="Invoices"
                           asp-action="Details"
                           asp-route-id="@Model.InvoiceNumber"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>