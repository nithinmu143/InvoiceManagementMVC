@model InvoiceManagementMVC.Models.InvoiceItem

@{
    ViewData["Title"] = "Delete Invoice Item";
}

<h1>Delete Invoice Item</h1>

<div class="alert alert-warning">

    <strong>Warning:</strong>
    Are you sure you want to delete this item?

</div>

<div class="card">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Item Title
            </dt>

            <dd class="col-sm-9">
                @Model.Title
            </dd>


            <dt class="col-sm-3">
                Quantity
            </dt>

            <dd class="col-sm-9">
                @Model.Quantity
            </dd>


            <dt class="col-sm-3">
                Price
            </dt>

            <dd class="col-sm-9">
                @Model.Price €
            </dd>


            <dt class="col-sm-3">
                Item Total
            </dt>

            <dd class="col-sm-9">
                <strong>
                    @Model.ItemTotal() €
                </strong>
            </dd>

        </dl>


        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <button type="submit"
                    class="btn btn-danger">
                Delete Item
            </button>


            <a asp-controller="Invoices"
               asp-action="Details"
               asp-route-id="@Model.InvoiceNumber"
               class="btn btn-secondary ms-2">
                Cancel
            </a>

        </form>

    </div>

</div>