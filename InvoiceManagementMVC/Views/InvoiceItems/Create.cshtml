@model InvoiceManagementMVC.Models.InvoiceItem

@{
    ViewData["Title"] = "Add Invoice Item";
}

<h1>Add Invoice Item</h1>

<hr />

<div class="row">
    <div class="col-md-5">

        <form asp-action="Create" method="post">

            <input type="hidden"
                   name="invoiceNumber"
                   value="@ViewBag.InvoiceNumber" />

            <!-- Item Title -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Item Title
                </label>

                <input name="title"
                       class="form-control"
                       placeholder="Enter item name"
                       required
                       maxlength="255" />

                <span class="text-danger">
                    @Html.ValidationMessage("Title")
                </span>

            </div>


            <!-- Quantity -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Quantity
                </label>

                <input name="quantity"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control"
                       placeholder="Enter quantity"
                       required />

                <span class="text-danger">
                    @Html.ValidationMessage("Quantity")
                </span>

            </div>


            <!-- Price -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Price
                </label>

                <input name="price"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="Enter price"
                       required />

                <span class="text-danger">
                    @Html.ValidationMessage("Price")
                </span>

            </div>


            <!-- Buttons -->
            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Add Item
                </button>

                <a asp-controller="Invoices"
                   asp-action="Details"
                   asp-route-id="@ViewBag.InvoiceNumber"
                   class="btn btn-secondary ms-2">
                    Back to Invoice
                </a>

            </div>

        </form>

    </div>
</div>